{
  "$comment": "site.webmanifest — example — adapt: name, colours and icons belong to the site. Notes: docs/seo.md.",
  "name": "Example Site",
  "short_name": "Example",
  "description": "A short description of the site, shown by browsers and the install prompt.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#0b0f17",
  "background_color": "#0b0f17",
  "lang": "en-US",
  "dir": "ltr",
  "icons": [
    { "src": "/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Contact", "short_name": "Contact", "url": "/#contact" }
  ]
}
