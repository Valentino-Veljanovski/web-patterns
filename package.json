{
  "name": "web-patterns",
  "version": "0.1.0",
  "description": "React and Next.js front-end patterns re-implemented from two live websites and two prototypes: motion, scroll, graphics, diagrams, navigation, SEO, a contact route, hosting files and an on-page assistant, with reduced-motion handling and a host proof in a built Next 16 app.",
  "type": "module",
  "license": "MIT",
  "author": "Valentino Veljanovski",
  "repository": {
    "type": "git",
    "url": "https://github.com/Valentino-Veljanovski/web-patterns"
  },
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": "./src/index.ts",
    "./motion": "./src/motion/index.ts",
    "./scroll": "./src/scroll/index.ts",
    "./graphics": "./src/graphics/index.ts",
    "./diagrams": "./src/diagrams/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./seo": "./src/seo/index.ts",
    "./contact": "./src/contact/index.ts",
    "./chat": "./src/chat/index.ts",
    "./hosting/*": "./src/hosting/*"
  },
  "files": [
    "src"
  ],
  "workspaces": [
    "examples/next-app"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:example": "npm run build --workspace examples/next-app",
    "host-proof": "node scripts/host-proof.mjs"
  },
  "peerDependencies": {
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.0",
    "next": "^16.3.8",
    "playwright": "1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
